# URL and anon key for the Supabase project used for login and cloud backup.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional dedicated Gemini proxy URL. When empty, the Supabase Edge Function
# at /functions/v1/stylist is used and requires a signed-in Supabase account.
EXPO_PUBLIC_STYLIST_URL=

# Optional: your own clothing-recognition service, used as a fallback when no
# Supabase account is signed in. Leave empty to disable it. If you deploy your
# own service, set its URL and a token of your choice (never commit real values).
EXPO_PUBLIC_RECOGNITION_URL=
EXPO_PUBLIC_APP_TOKEN=

# Edge Functions: configure REMOVE_BG_API_KEY as a Supabase secret (server only).
# Optional upstream URL for the background-removal provider; defaults to remove.bg.
# Set BACKGROUND_REMOVAL_API_URL as a Supabase secret if the provider endpoint changes.
