{
  "expo": {
    "name": "meteo-vetements",
    "slug": "meteo-vetements",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meteovetements",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F1FF",
    "primaryColor": "#9B7BFF",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pour afficher la météo de ta position et choisir ta tenue."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour importer les photos de tes vêtements.",
          "cameraPermission": "Pour photographier tes vêtements."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
