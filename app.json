{
  "expo": {
    "name": "HabilleToi",
    "slug": "meteo-vetements",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meteovetements",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#7C5CFF",
    "ios": {
      "bundleIdentifier": "com.meteovetements.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.meteovetements.app",
      "blockedPermissions": ["android.permission.WRITE_CALENDAR"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pour afficher la météo de ta position et choisir ta tenue."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour importer les photos de tes vêtements.",
          "cameraPermission": "Pour photographier tes vêtements."
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Pour repérer l’occasion de ta journée et adapter la tenue proposée."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.meteovetements.app.widgets",
          "groupIdentifier": "group.com.meteovetements.app",
          "widgets": [
            {
              "name": "DailyOutfitWidget",
              "displayName": "Tenue du jour",
              "description": "La tenue conseillée et la météo du jour.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
